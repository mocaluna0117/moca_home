# 20and20 store (EC-CUBE) credentials — copy to .env.local and fill in
ECCUBE_BASE_URL=https://20and20.pet/store
ECCUBE_LOGIN_EMAIL=
ECCUBE_LOGIN_PASSWORD=

# local SQLite database path
DATABASE_PATH=./data/app.db

# politeness delay between scraper requests (ms)
SCRAPER_DELAY_MS=1000

# libSQL / Turso — local dev uses a file URL; production uses the Turso URL
TURSO_DATABASE_URL=file:./data/app.db
TURSO_AUTH_TOKEN=

# app login gate — set both in production
AUTH_SECRET=
APP_PASSWORD=

# 接種証明書の自動読み取り（任意）。未設定なら写真の添付だけ動く。
# 送る前にブラウザ上で氏名・住所を黒塗りできる（保存される写真は塗られない）。
#
# Gemini（無料枠あり・こちらが優先される）
#   キーは https://aistudio.google.com/apikey で発行する。
#   注意: 無料枠は規約上、送った内容が Google の製品改善に使われうる。
GEMINI_API_KEY=
# 省略時は gemini-2.5-flash
GEMINI_MODEL=
# 手元でモックに向けて検証するときだけ使う。本番では設定しない
GEMINI_BASE_URL=

# Claude（従量課金・入力は学習に使われない）。GEMINI_API_KEY が無いときに使う
#   キーは https://console.anthropic.com/ で発行する。
ANTHROPIC_API_KEY=
# 省略時は claude-opus-5
ANTHROPIC_MODEL=

# ---- フィラリアのリマインドメール（任意）----
# 3つそろって初めて送信が有効になる。1つでも欠ければ予定の記録だけが動く。
# 送信元にする Gmail アドレス
GMAIL_USER=
# Google アカウントの「アプリパスワード」16桁。
# https://myaccount.google.com/apppasswords で発行する（2段階認証が前提）。
# 画面には4桁ずつ区切って出るが、空白入りのまま貼ってよい
GMAIL_APP_PASSWORD=
# 宛先。カンマか空白で区切って複数指定できる（5件まで）
HEARTWORM_MAIL_TO=

# Vercel Cron からの呼び出しを検証する秘密。16文字以上。
# **未設定だと cron は 401 になり、リマインドは飛ばない**
# （設定を忘れて誰でも叩ける口ができるより、動かないほうがよい）
CRON_SECRET=

# メール本文に載せるアプリのURL（任意）。未設定なら Vercel の本番URLを使う
NEXT_PUBLIC_APP_URL=

# 465 が塞がれていたときの逃げ道（任意）。既定は smtp.gmail.com:465
SMTP_HOST=
SMTP_PORT=

