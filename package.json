{
  "name": "moca_home",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync": "tsx --conditions=react-server --env-file=.env.local scripts/sync.ts",
    "db:push": "tsx --env-file=.env.local node_modules/drizzle-kit/bin.cjs push",
    "test": "tsx --test src/lib/bonus.test.ts src/lib/core-name.test.ts src/lib/calendar.test.ts src/lib/favorites.test.ts src/lib/vaccination-extract.test.ts src/lib/route-params.test.ts src/lib/heartworm.test.ts src/lib/cron-auth.test.ts src/lib/care.test.ts src/lib/mail-config.test.ts src/lib/profile.test.ts src/lib/home.test.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.turso scripts/migrate-to-turso.ts",
    "sync:prod": "tsx --conditions=react-server --env-file=.env.local --env-file=.env.turso scripts/sync.ts",
    "db:push:log": "tsx --env-file-if-exists=.env.turso scripts/push-log-tables.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@base-ui/react": "^1.7.0",
    "@google/genai": "^2.19.0",
    "@libsql/client": "^0.17.4",
    "@vercel/blob": "^2.8.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
